# Giữ nguyên kiểu xuống dòng khi clone trên Windows.
* text=auto

# Các file chạy trong Linux container bắt buộc LF, nếu không entrypoint.sh
# sẽ lỗi "/bin/sh^M: bad interpreter".
*.sh text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.md text eol=lf
