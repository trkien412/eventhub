# ============================================================================
# SAO CHÉP FILE NÀY THÀNH .env RỒI THAY TOÀN BỘ GIÁ TRỊ MẪU.
# TUYỆT ĐỐI KHÔNG COMMIT FILE .env LÊN GITHUB.
# Gợi ý tạo chuỗi ngẫu nhiên:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# ============================================================================

# --- Django ---
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DJANGO_LOG_LEVEL=INFO
DJANGO_SESSION_AGE=28800

# Chỉ bật các mục dưới sau khi website đã chạy bằng HTTPS thật.
DJANGO_SECURE_COOKIES=False
DJANGO_SSL_REDIRECT=False
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False

# --- PostgreSQL ---
POSTGRES_DB=event_db
POSTGRES_USER=event_user
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# Chỉ dùng khi chạy ngoài Docker; trong Compose đã đặt POSTGRES_HOST=db.
# POSTGRES_HOST=db
# POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60

# --- Cổng truy cập (mặc định chỉ mở website ra ngoài) ---
HTTP_PORT=8080
PGADMIN_PORT=5050
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100

# --- pgAdmin (chỉ bind 127.0.0.1) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-strong-pgadmin-password

# --- Grafana (chỉ bind 127.0.0.1) ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace-with-a-strong-grafana-password

# --- Gunicorn ---
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
